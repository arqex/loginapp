generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DB_URL")
  relationMode = "foreignKeys"
}

model AuthToken {
  key       String        @id @default(cuid())
  createdAt DateTime      @default(now())
  expiresAt DateTime?
  type      AuthTokenType
  userId    String
  meta      Json
  owner     User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// User model represents application users
model User {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  email      String           @unique
  meta       Json             // User BE controlled metadata (name, profile info, etc.)
  clientData Json             // Client-side preferences and settings stored as JSON
  tokens     AuthToken[]
  accounts   UsersOnAccount[]
}

model Account {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  meta        Json
  invitations Invitation[]
  todoLists   TodoList[]       @relation("AccountTodoLists")
  users       UsersOnAccount[]
}

model UsersOnAccount {
  userId    String
  accountId String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  role      UsersOnAccountRole
  account   Account            @relation(fields: [accountId], references: [id])
  user      User               @relation(fields: [userId], references: [id])

  @@id([userId, accountId])
  @@index([accountId])
}

model Invitation {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  email     String
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)
  secret    String
  meta      Json
  accountId String
  account   Account          @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([email])
}

model TodoList {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  name      String
  accountId String
  items     TodoItem[]
  account   Account    @relation("AccountTodoLists", fields: [accountId], references: [id])

  @@index([accountId], map: "TodoList_accountId_fkey")
}

model TodoItem {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  title      String
  completed  Boolean  @default(false)
  todoListId String
  todoList   TodoList @relation(fields: [todoListId], references: [id], onDelete: Cascade)

  @@index([todoListId], map: "TodoItem_todoListId_fkey")
}

enum AuthTokenType {
  EMAIL_LOGIN
  API_KEY
  OAUTH20
  PROVIDER_LOGIN
}

enum UsersOnAccountRole {
  ADMIN
  EDITOR
  COLLABORATOR
}

enum InvitationStatus {
  PENDING
  DECLINED
  ACCEPTED
  CANCELLED
}
