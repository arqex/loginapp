// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
  relationMode = "foreignKeys"
}

enum AuthTokenType {
  EMAIL_LOGIN // email + password, email validation, password recovery, login token
  API_KEY
  OAUTH20
  PROVIDER_LOGIN
}

model AuthToken {
  key       String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime? 
  type      AuthTokenType
  userId    String
  owner     User     @relation(fields: [userId], references: [id])
  meta      Json

  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  meta      Json
  tokens    AuthToken[]
  accounts  UsersOnAccount[]
  invitations Invitation[]
}

model Account {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meta      Json
  users     UsersOnAccount[]
  todoLists TodoList[] @relation("AccountTodoLists")
  invitations Invitation[]
}

model UsersOnAccount {
  userId    String
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      UsersOnAccountRole
  user      User     @relation(fields: [userId], references: [id])
  account   Account  @relation(fields: [accountId], references: [id])

  @@id([userId, accountId])
  @@index([accountId])
}

enum UsersOnAccountRole {
  ADMIN
  EDITOR
  COLLABORATOR
}

enum InvitationStatus {
  PENDING
  DECLINED
  ACCEPTED
  CANCELLED
}

model Invitation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)
  meta      Json
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  user      User?    @relation(fields: [email], references: [email])

  @@index([accountId])
  @@index([email])
}

model TodoList {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  accountId String
  account   Account  @relation("AccountTodoLists", fields: [accountId], references: [id])
  items     TodoItem[]
}

model TodoItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  completed Boolean  @default(false)
  todoListId String
  todoList   TodoList @relation(fields: [todoListId], references: [id])
}